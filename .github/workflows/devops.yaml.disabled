name: DevOps Traditional Pipeline (Build, Tag & Deploy)

on:
  push:
    branches: [ "main" ]

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}

jobs:
  build-and-deploy:
    name: Build and Deploy Traditional Image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Extract metadata (tags, labels) for Docker
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=raw,value=devops-latest
            type=sha,format=long

      - name: Log in to the Container registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # Build and Push
      - name: Build and Push Docker image
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ./Dockerfile
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      # Config para Self-Hosted Runner
      #- name: Deploy to K8s Cluster via VM OCI
      #  uses: appleboy/ssh-action@v1.0.3
      #  with:
      #    host: ${{ secrets.OCI_VM_IP }}
      #    username: opc
      #    key: ${{ secrets.OCI_SSH_KEY }}
      #    script: |
      #      echo "${{ secrets.KUBECONFIG_DATA }}" | base64 -d > ~/.kube/config
      #      kubectl apply -f k8s/03-deployment.yaml